  "field_semantics": {
    "record_id": "string",
    "dataset_role": "calibration or validation",
    "trajectory_id": "string",
    "replicate_id": "string",
    "timestamp_utc": "string",
    "elapsed_s": "nonnegative decimal physical seconds",
    "device_tick": "string",
