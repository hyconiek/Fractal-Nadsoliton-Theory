  "physical_integrity_requirements": [
    "signed/raw timestamps or monotonic clock trace",
    "actual independent calibration-vs-validation split",
    "one record ID and one reset ID per independent experimental preparation",
    "raw absolute labels and readout to test phase effects",
    "model compilation hashes and gain controller logs",
    "detector invalid readouts even if excluded by instrument",
    "physical clock/latency offsets and drift",
    "dataset provenance, subject to human review",
    "defined independence: one validated independent replicate per statistical iid shot OR proved concentration for dependence"
  ],
  "no_inference_from_schema_alone": [
    "physical oscillator calibration",
    "true gain",
    "iid replicates",
    "stochastic instrument is nondisturbing"
  ],
