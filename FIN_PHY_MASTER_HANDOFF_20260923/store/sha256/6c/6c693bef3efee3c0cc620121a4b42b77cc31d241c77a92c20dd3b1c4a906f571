#!/usr/bin/env python3
from pathlib import Path
import hashlib,sys
ROOT=Path(__file__).resolve().parent
man=ROOT/'MANIFEST.sha256'
if not man.exists():
 print('manifest missing');sys.exit(1)
bad=[];n=0
for line in man.read_text().splitlines():
 if not line.strip():continue
 h,rel=line.split(None,1);rel=rel.strip();p=ROOT/rel;n+=1
 if not p.exists():bad.append((rel,'MISSING'));continue
 got=hashlib.sha256(p.read_bytes()).hexdigest()
 if got!=h:bad.append((rel,got))
print(f'MANIFEST files={n} bad={len(bad)}')
for x in bad:print('BAD',*x)
sys.exit(1 if bad else 0)
