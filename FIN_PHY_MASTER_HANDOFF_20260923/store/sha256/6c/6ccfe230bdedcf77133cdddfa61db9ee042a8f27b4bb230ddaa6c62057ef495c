#!/usr/bin/env python3
from pathlib import Path
import json, math
ROOT=Path(__file__).resolve().parents[1]
rows=[]
for M in [16,32,64,128,256]:
    h=1.0/M
    kappa=1.0; mu=1.0; nu=1.0; eta=1.0
    # lattice maximum group speed for wave and Schrodinger under the same static stiffness kappa/h
    v_wave=math.sqrt(kappa/mu)
    v_sch=2*kappa/(eta*h) # maximum |d omega/dp| for omega=4 kappa/(eta h^2) sin^2(ph/2)
    rows.append({'M':M,'h':h,'wave_vmax':v_wave,'schrodinger_lattice_vmax':v_sch})
out={
 'task':'DYN-01-static-action-dynamics-nonidentifiability',
 'scientific_state':'PROVED_ANALYTIC_STATIC_REFINEMENT_DOES_NOT_SELECT_TIME_LAW',
 'shared_static_energy':'F_h=(kappa0/(2h)) sum_i (u_{i+1}-u_i)^2',
 'dynamics':{
   'gradient_heat':'nu0 h du_i/dt = -dF/du_i -> nu0 u_t = kappa0 u_xx',
   'inertial_wave':'mu0 h d2u_i/dt2 = -dF/du_i -> mu0 u_tt = kappa0 u_xx',
   'unitary_schrodinger':'i eta0 h du_i/dt = dF/du_i -> i eta0 u_t = -kappa0 u_xx (complex lift required)'
 },
 'same_statics':'All three use the same refinement-compatible spatial Dirichlet form. The first is dissipative, the second hyperbolic/conservative after adding momentum, and the third dispersive after complexification.',
 'speed_contrast':rows,
 'continuum_speed_statement':'Wave: finite characteristic/group speed sqrt(kappa0/mu0). Heat: no exact finite cone. Schrodinger continuum group velocity is proportional to |p| and has no finite global maximum; its lattice maximum diverges like 1/h.',
 'conclusion':'Neither the phase metric nor the 1/ell spatial stiffness selects hyperbolic propagation. The bounded-speed result is conditional on an independently supplied inertial/kinetic law.',
 'nonconclusions':['No preference among these dynamics is inferred from equilibrium FIN.','The complex Schrodinger lift is only a null/control construction, not a FIN-derived quantum theory.']
}
p=ROOT/'results'/'DYN-01_three_dynamics.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'last':rows[-1]},indent=2))
