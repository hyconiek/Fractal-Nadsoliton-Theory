#!/usr/bin/env python3
from pathlib import Path
import subprocess,sys,hashlib
ROOT=Path(__file__).resolve().parent
for p in sorted((ROOT/'scripts').glob('*.py')):
 print('RUN',p.name,flush=True)
 subprocess.run([sys.executable,str(p)],cwd=ROOT,env={**__import__('os').environ,'PYTHONDONTWRITEBYTECODE':'1'},check=True,stdout=subprocess.DEVNULL)
if '--check' in sys.argv:
 bad=[]
 for line in (ROOT/'EXPECTED_RESULTS.sha256').read_text().splitlines():
  h,rel=line.split('  ',1); p=ROOT/rel
  got=hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else 'MISSING'
  if got!=h: bad.append((rel,h,got))
 if bad:
  print('REPLAY CHECK FAIL',bad); raise SystemExit(1)
 print('REPLAY CHECK PASS',len((ROOT/'results').glob('*.json')) if False else sum(1 for _ in (ROOT/'results').glob('*.json')))
