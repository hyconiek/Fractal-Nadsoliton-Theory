 # number unordered pairs differing in both coordinates in n x m product; these entries are forced zero in B⊗I+I⊗C.
 forced=n*(n-1)*m*(m-1)//2
 factorizations.append({'n':n,'m':m,'forced_zero_offdiagonal_entries_in_any_Kronecker_sum':forced})
 assert forced>0
