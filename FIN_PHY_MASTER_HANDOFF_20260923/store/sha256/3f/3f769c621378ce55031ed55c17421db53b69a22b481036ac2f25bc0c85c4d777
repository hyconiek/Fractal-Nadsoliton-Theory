}
p=ROOT/'results'/'CARRIER-SOURCE_factorization_no_go.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'nonzero_offdiag':nonzero,'factorizations':factorizations},indent=2))
