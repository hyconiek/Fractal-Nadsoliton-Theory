#!/usr/bin/env python3
from pathlib import Path
import json, math
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
w=np.array([3,4,5],dtype=int)
# Primitive Z-basis of {n in Z^3 : n.w=0}; cross product = -w proves index one.
L=np.array([[-3,1,1],[-1,2,-1]],dtype=int)
assert np.all(L@w==0)
cross=np.cross(L[0],L[1])
assert np.array_equal(cross,-w)
assert math.gcd(math.gcd(*map(abs,w[:2])),abs(int(w[2])))==1
out={
 'task':'HDIM-01-intrinsic-shape-torus',
 'scientific_state':'PROVED_EXACT_INTRINSIC_T2_SHAPE_QUOTIENT',
 'phase_space':'T^3 for nonzero smooth Fourier modes k=(3,4,5)',
 'translation_action':'alpha: (phi3,phi4,phi5)->(phi3+3 alpha,phi4+4 alpha,phi5+5 alpha)',
 'translation_weight':w.tolist(),
 'gcd_weights':1,
 'primitive_invariant_lattice_basis':L.tolist(),
 'primitive_check_cross_product':cross.tolist(),
 'shape_coordinates':['chi1=-3 phi3+phi4+phi5','chi2=-phi3+2 phi4-phi5'],
 'theorem':'Because gcd(3,4,5)=1 the weighted S1 action is effective, and the primitive character lattice ker_Z(3,4,5) has rank two. Hence T^3/S1_(3,4,5) is a two-torus. The displayed rows form a primitive basis because their cross product is -(3,4,5).',
 'interpretation':'This is a genuine per-cell internal relational shape manifold, not yet a low-energy degeneracy or spatial manifold.',
 'nonconclusions':['T2 is not a second/third spatial dimension.','The localized minimum does not populate the whole T2 in the sharp-cell limit.','No physical length scale or metric is supplied by topology alone.']
}
p=ROOT/'results'/'HDIM-01_shape_torus.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'basis':L.tolist(),'cross':cross.tolist()},indent=2))
