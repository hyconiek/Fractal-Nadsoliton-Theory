#!/usr/bin/env python3
from pathlib import Path
import subprocess, hashlib, sys, os
ROOT=Path(__file__).resolve().parent
scripts=sorted((ROOT/'scripts').glob('*.py'))
env=dict(os.environ);env['PYTHONDONTWRITEBYTECODE']='1'
for s in scripts:
    print('RUN',s.name,flush=True)
    subprocess.run([sys.executable,str(s)],cwd=ROOT,env=env,check=True,stdout=subprocess.DEVNULL)
expected={}
for line in (ROOT/'EXPECTED_RESULTS.sha256').read_text().splitlines():
    h,p=line.split(None,1);expected[p.strip()]=h
bad=[]
for rel,h in expected.items():
    p=ROOT/rel
    got=hashlib.sha256(p.read_bytes()).hexdigest()
    if got!=h:bad.append((rel,h,got))
print(f'REPLAY results={len(expected)} bad={len(bad)}')
for x in bad:print('BAD',*x)
raise SystemExit(1 if bad else 0)
