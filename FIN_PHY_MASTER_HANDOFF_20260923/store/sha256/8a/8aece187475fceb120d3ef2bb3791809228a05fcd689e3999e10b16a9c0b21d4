#!/usr/bin/env python3
from pathlib import Path
import json, math, sys
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces()

def crt_j(a,b):
    for j in range(12):
        if j%3==a and j%4==b:return j
    raise RuntimeError
pairs=[(a,b) for a in range(3) for b in range(4)]
perm=[crt_j(a,b) for a,b in pairs]
assert len(set(perm))==12
# Translation/reflection in CRT coordinates.
def pair_of(j): return (j%3,j%4)
trans_ok=all(pair_of((j+t)%12)==((j%3+t)%3,(j%4+t)%4) for j in range(12) for t in range(12))
refl_ok=all(pair_of((-j)%12)==((-j)%3,(-j)%4) for j in range(12))
# Convolution coefficient matrix in CRT coordinates and operator Schmidt rank.
Acrt=A[np.ix_(perm,perm)]
T=Acrt.reshape(3,4,3,4).transpose(0,2,1,3).reshape(9,16)
osr=int(np.linalg.matrix_rank(T,tol=1e-10))
K=np.zeros((3,4))
for a in range(3):
    for b in range(4): K[a,b]=A[0,crt_j(a,b)]
coef_rank=int(np.linalg.matrix_rank(K,tol=1e-10))
# Additive separability K(a,b)=u(a)+v(b): all rectangular mixed differences vanish. Measure max violation.
viol=0.0
for a1 in range(3):
 for a2 in range(3):
  for b1 in range(4):
   for b2 in range(4):
    viol=max(viol,abs(K[a1,b1]+K[a2,b2]-K[a1,b2]-K[a2,b1]))
# Primary factor sizes for declared doubling and an equally natural sextupling refinement.
def prime_exponents(n):
 d={};p=2
 x=n
 while p*p<=x:
  while x%p==0:d[p]=d.get(p,0)+1;x//=p
  p+=1
 if x>1:d[x]=d.get(x,0)+1
 return d
rows=[]
for n in range(7):
 q2=12*(2**n); q6=12*(6**n)
 rows.append({'n':n,'doubling_q':q2,'doubling_primary_sizes':[p**a for p,a in sorted(prime_exponents(q2).items())],
              'sextupling_q':q6,'sextupling_primary_sizes':[p**a for p,a in sorted(prime_exponents(q6).items())]})
out={
 'task':'CARRIER-02B_origin_free_CRT_torsor_factorization',
 'scientific_state':'PROVED_CANONICAL_FINITE_TWO_FACTOR_TORSOR__DYNAMICAL_INDEPENDENCE_REFUTED',
 'crt_bijection_ordering':perm,'translation_equivariant':trans_ok,'reflection_equivariant':refl_ok,
 'theorem':'A Z12 torsor has characteristic subgroup quotients of sizes 3 and 4; the map to their product is a bijection and does not require a chosen basepoint. In coordinates it is the CRT factorization Z12 ~= Z3 x Z4, equivariant under translations and inversion.',
 'strict_A_CRT_operator_schmidt_rank':osr,'strict_A_convolution_coefficient_rank':coef_rank,
 'max_additive_separability_rectangle_violation':viol,
 'dynamical_result':'The strict operator couples the two CRT factors: its kernel is not additively separable, and prior Kronecker-sum no-go remains in force.',
 'refinement_table':rows,
 'continuum_guard':'Under q_n=12*2^n only the 2-primary factor diverges while the Z3 factor remains finite; under q_n=12*6^n both primary factors diverge. Thus the same q=12 carrier admits refinement paths with different numbers of growing arithmetic factors unless a refinement law is sourced.',
 'nonconclusions':['two CRT factors are not two spatial dimensions','operator Schmidt rank 3 is not a physical dimension','a product metric on CRT factors is not sourced']
}
p=ROOT/'results'/'CARRIER-02B_crt_torsor.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps(out,indent=2))
