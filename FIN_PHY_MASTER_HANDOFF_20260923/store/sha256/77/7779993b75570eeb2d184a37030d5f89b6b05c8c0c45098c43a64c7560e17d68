#!/usr/bin/env python3
from pathlib import Path
import hashlib
ROOT=Path(__file__).resolve().parent
bad=[];n=0
for line in (ROOT/'MANIFEST.sha256').read_text().splitlines():
 if not line.strip(): continue
 h,rel=line.split(None,1);rel=rel.strip();p=ROOT/rel;n+=1
 if not p.exists(): bad.append((rel,'MISSING',h));continue
 got=hashlib.sha256(p.read_bytes()).hexdigest()
 if got!=h:bad.append((rel,got,h))
if bad:
 print('VERIFY FAIL',len(bad))
 for x in bad:print(x)
 raise SystemExit(1)
print(f'VERIFY PASS files={n}')
