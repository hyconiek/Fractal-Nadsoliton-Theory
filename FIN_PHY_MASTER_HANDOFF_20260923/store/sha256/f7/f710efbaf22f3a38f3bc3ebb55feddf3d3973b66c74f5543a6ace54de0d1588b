#!/usr/bin/env python3
from pathlib import Path
import json, math, sys
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces();q=12;j=np.arange(q)
# A minimal positive two-state fiber Laplacian, used only to verify the general algebraic intertwiner.
B=np.array([[1.,-1.],[-1.,1.]])
b0=np.array([1.,1.])/math.sqrt(2)
A24=np.kron(A,np.eye(2))+np.kron(np.eye(12),B)
E=np.kron(np.eye(12),b0[:,None]) # 24x12
F=E.T
inter=float(np.linalg.norm(A24@E-E@A)); left=float(np.linalg.norm(F@E-np.eye(12)))
# Build one generic independent-doublet rotation R in real Fourier coordinates.
cols=[np.ones(q)/math.sqrt(q)]
for k in range(1,6):
 cols += [np.sqrt(2/q)*np.cos(2*np.pi*k*j/q),np.sqrt(2/q)*np.sin(2*np.pi*k*j/q)]
cols += [((-1.)**j)/math.sqrt(q)]
U=np.column_stack(cols); assert np.linalg.norm(U.T@U-np.eye(12))<1e-12
angles=[.13,.27,-.41,.52,-.66]; blocks=[np.ones((1,1))]
for a in angles: blocks.append(np.array([[math.cos(a),-math.sin(a)],[math.sin(a),math.cos(a)]]))
blocks.append(np.ones((1,1)))
# manual blockdiag
Rhat=np.zeros((12,12)); idx=0
for bl in blocks:
 n=bl.shape[0];Rhat[idx:idx+n,idx:idx+n]=bl;idx+=n
R=U@Rhat@U.T; R24=np.kron(R,np.eye(2))
comm12=float(np.linalg.norm(R@A-A@R));comm24=float(np.linalg.norm(R24@A24-A24@R24)); intertwine_rot=float(np.linalg.norm(R24@E-E@R))
assert max(inter,left,comm12,comm24,intertwine_rot)<1e-11
out={
 'task':'HDIM-12-refinement-persistence',
 'scientific_state':'PROVED_KRONECKER_REFINEMENT_PRESERVES_COARSE_T5_SPECTRAL_PHASE_CARRIER',
 'numeric_witness':{'A24E_minus_EA_fro':inter,'F_E_minus_I_fro':left,'RA_minus_AR_fro':comm12,'R24A24_minus_A24R24_fro':comm24,'R24E_minus_ER_fro':intertwine_rot},
 'general_theorem':'For any refinement A_prime=A tensor I + I tensor B with a normalized fiber vector b0 in ker B, E(f)=f tensor b0 intertwines A and A_prime and F=E* is a left inverse. Every orthogonal R commuting with A lifts to R tensor I commuting with A_prime, and (R tensor I)E=ER. Hence the entire coarse spectral-phase torus survives exactly on the fiber-constant sector and is recovered by forgetting the fiber.',
 'scope':'Conditional on the declared Kronecker-sum refinement form and a zero fiber mode. The concrete B2 here is a theorem sanity check, not a source for nature or for the existing refinement coefficient.',
 'conclusion':'Unlike the massive nonlinear T2 tangent, the strict operator T5 has an exact algebraic refinement/forgetful persistence mechanism.'
}
p=ROOT/'results'/'HDIM-12_kronecker_refinement.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'max_residual':max(inter,left,comm12,comm24,intertwine_rot)},indent=2))
