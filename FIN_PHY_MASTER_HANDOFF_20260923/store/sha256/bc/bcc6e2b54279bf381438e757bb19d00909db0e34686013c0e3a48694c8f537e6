from pathlib import Path
import json, sys, math
import numpy as np
from scipy.linalg import expm
from scipy.optimize import brentq
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces();q=12;j=np.arange(q)
# rotate between distinct k=1 and k=2 cosine eigendirections, fixing uniform vector
v=np.cos(2*np.pi*j/q);v-=v.mean();v/=np.linalg.norm(v)
w=np.cos(4*np.pi*j/q);w-=w.mean();w-=v*np.dot(v,w);w/=np.linalg.norm(w)
K=np.outer(v,w)-np.outer(w,v)
ones=np.ones(q)
mask=~np.eye(q,dtype=bool)
def stats(e):
 Q=expm(e*K);Ap=Q.T@A@Q
 return Q,Ap,float(Ap[mask].max()),float(Ap[mask].min()),float(np.linalg.norm(Ap@ones)),float(np.linalg.norm(Ap-A))
def f(e):return stats(e)[2]
# first positive crossing in scanned interval
root=brentq(f,0.2,0.35)
eps=0.2;Q,Ap,mx,mn,rs,dif=stats(eps)
# check Q is far from any permutation through max row entries not all 1; use orthogonal mixing witness
row_max=np.max(np.abs(Q),axis=1)
# spectra
spec_err=float(np.max(np.abs(np.linalg.eigvalsh(Ap)-np.linalg.eigvalsh(A))))
# noncirculant defect against cyclic shift
S=np.roll(np.eye(q),1,axis=0)
noncirc=float(np.linalg.norm(S@Ap-Ap@S))
