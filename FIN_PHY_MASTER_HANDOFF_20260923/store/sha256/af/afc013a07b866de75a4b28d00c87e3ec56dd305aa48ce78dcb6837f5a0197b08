#!/usr/bin/env python3
from pathlib import Path
import hashlib
root=Path(__file__).resolve().parent
bad=[]; n=0
for line in (root/'MANIFEST.sha256').read_text().splitlines():
    if not line.strip(): continue
    h,name=line.split('  ',1); name=name[2:] if name.startswith('./') else name
    p=root/name; n+=1
    if not p.exists(): bad.append((name,'MISSING')); continue
    got=hashlib.sha256(p.read_bytes()).hexdigest()
    if got!=h: bad.append((name,got))
if bad:
    print('VERIFY FAIL',bad); raise SystemExit(1)
print(f'VERIFY PASS: {n}/{n} manifest files')
