#!/usr/bin/env python3
from pathlib import Path
import argparse, subprocess, os, hashlib, shutil
ROOT=Path(__file__).resolve().parent
ap=argparse.ArgumentParser();ap.add_argument('--check',action='store_true');args=ap.parse_args()
expected={}
for line in (ROOT/'EXPECTED_RESULTS.sha256').read_text().splitlines():
 if not line.strip(): continue
 h,rel=line.split(None,1);expected[rel.strip()]=h
for p in (ROOT/'results').glob('*.json'): p.unlink()
env=dict(os.environ);env['PYTHONDONTWRITEBYTECODE']='1'
for s in sorted((ROOT/'scripts').glob('*.py')):
 print('RUN',s.name,flush=True)
 subprocess.run(['python3',str(s)],cwd=ROOT,env=env,check=True,stdout=subprocess.DEVNULL)
if args.check:
 bad=[]
 for rel,h0 in expected.items():
  p=ROOT/rel
  if not p.exists(): bad.append((rel,'MISSING',h0));continue
  h=hashlib.sha256(p.read_bytes()).hexdigest()
  if h!=h0: bad.append((rel,h,h0))
 extra=sorted(str(p.relative_to(ROOT)) for p in (ROOT/'results').glob('*.json') if str(p.relative_to(ROOT)) not in expected)
 if bad or extra:
  print('REPLAY CHECK FAIL')
  for x in bad:print('BAD',x)
  for x in extra:print('EXTRA',x)
  raise SystemExit(1)
 print(f'REPLAY CHECK PASS results={len(expected)}')
