#!/usr/bin/env python3
from pathlib import Path
import hashlib,sys
root=Path(__file__).resolve().parent
manifest=root/'MANIFEST.sha256'
if not manifest.exists():
    print('MANIFEST missing'); raise SystemExit(1)
bad=[]; n=0
for line in manifest.read_text().splitlines():
    if not line.strip(): continue
    h0,rel=line.split(None,1); rel=rel.strip(); p=root/rel; n+=1
    if not p.exists(): bad.append((rel,'MISSING')); continue
    h=hashlib.sha256(p.read_bytes()).hexdigest()
    if h!=h0: bad.append((rel,h))
if bad:
    print('VERIFY FAIL',bad[:20]); raise SystemExit(1)
print(f'VERIFY PASS {n}/{n}')
