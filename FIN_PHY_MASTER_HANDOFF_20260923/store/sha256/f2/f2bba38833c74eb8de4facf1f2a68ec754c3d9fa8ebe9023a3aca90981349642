#!/usr/bin/env python3
from pathlib import Path
import subprocess, hashlib, sys
root=Path(__file__).resolve().parent
scripts=sorted((root/'scripts').glob('*.py'))
for s in scripts:
    print('RUN',s.name,flush=True)
    subprocess.run([sys.executable,str(s)],check=True)
expected={}
for line in (root/'EXPECTED_RESULTS.sha256').read_text().splitlines():
    h,p=line.split(maxsplit=1); expected[p.strip()]=h
bad=[]
for rel,h in expected.items():
    data=(root/rel).read_bytes(); got=hashlib.sha256(data).hexdigest()
    if got!=h: bad.append((rel,h,got))
if bad:
    print('REPLAY HASH MISMATCH',bad); raise SystemExit(1)
print(f'REPLAY CHECK PASS: {len(expected)}/{len(expected)} result hashes match')
