#!/usr/bin/env python3
from pathlib import Path
import subprocess, hashlib, os, sys
root=Path(__file__).resolve().parent
scripts=[
 'memory_alias_theorem.py',
 'persistent_memory_identification.py',
 'bounded_hidden_dimension_theorem.py',
 'calibrated_carrier_identifiability.py',
 'channel_first_jet_theorem.py',
]
env=dict(os.environ); env['PYTHONDONTWRITEBYTECODE']='1'
for s in scripts:
    p=subprocess.run([sys.executable,str(root/'scripts'/s)],cwd=root,env=env,text=True,capture_output=True)
    if p.returncode:
        print(p.stdout); print(p.stderr,file=sys.stderr); raise SystemExit(p.returncode)
expected={}
for line in (root/'EXPECTED_RESULTS.sha256').read_text().splitlines():
    h,path=line.split(maxsplit=1); expected[path]=h
bad=[]
for rel,h in expected.items():
    data=(root/rel).read_bytes(); got=hashlib.sha256(data).hexdigest()
    if got!=h: bad.append((rel,h,got))
if bad:
    print('REPLAY MISMATCH')
    for row in bad: print(*row)
    raise SystemExit(2)
print(f'REPLAY CHECK PASS: {len(expected)}/{len(expected)} results identical')
