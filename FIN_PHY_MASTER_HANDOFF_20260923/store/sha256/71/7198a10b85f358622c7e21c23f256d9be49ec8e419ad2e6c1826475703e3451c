   'fixed_support_plus_trace_derives_A7':'REFUTED_IN_SCOPE',
   'single_cell_core_derives_composition':'REFUTED_IN_SCOPE',
   'target_independent_source_lane':'OPEN_WITH_TYPED_ATOM_SO-PHY-012-01'
 }
}
