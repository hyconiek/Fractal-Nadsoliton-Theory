#!/usr/bin/env python3
from pathlib import Path
import json
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
d=json.loads((ROOT/'inputs'/'DIM-01_phase_coordinate_rank.json').read_text())
H=np.array(d['numeric_center_check']['H_phi'],float)
w=np.array([3.,4.,5.]); L=np.array([[-3.,1.,1.],[-1.,2.,-1.]])
assert np.linalg.norm(L@w)<1e-12
Hp=np.linalg.pinv(H,rcond=1e-12)
C=L@Hp@L.T
G=np.linalg.inv(C)
eH=np.linalg.eigvalsh((H+H.T)/2); eC=np.linalg.eigvalsh(C); eG=np.linalg.eigvalsh(G)
assert eH[1]>1.4 and eC[0]>2 and eG[0]>0.12
out={
 'task':'HDIM-02-shape-metric-and-local-fluctuation-law',
 'scientific_state':'PROVED_LOCAL_2D_SHAPE_METRIC__CONDITIONAL_LAPLACE_GAUSSIAN_TANGENT',
 'phase_hessian':H.tolist(),
 'phase_hessian_eigenvalues':eH.tolist(),
 'shape_lattice_basis':L.astype(int).tolist(),
 'shape_covariance_coefficient_C_for_sqrtN_chi':C.tolist(),
 'shape_covariance_eigenvalues':eC.tolist(),
 'shape_metric_G_Cinverse':G.tolist(),
 'shape_metric_eigenvalues':eG.tolist(),
 'condition_number_C':float(np.linalg.cond(C)),
 'laplace_statement':'In the exact finite-N auxiliary-field ensemble, after conditioning on one localized cap and fixing the translation zero mode, the nondegenerate local Laplace theorem gives sqrt(N)*(chi-chi*) => Normal(0,C), with C=L H_phi^+ L^T. The polar-coordinate Jacobian contributes only O(1) to log density and does not change the leading N Hessian.',
 'canonical_standardization':'Y=C^{-1/2} sqrt(N) (chi-chi*) has asymptotic N(0,I2).',
 'interpretation':'The current FIN branch contains a canonical two-dimensional internal fluctuation tangent plane even though only one phase direction is symmetry/Goldstone-like.',
 'scope':['local cap only','finite-N added ensemble','translation gauge fixed','not a spatial metric or SI geometry']
}
p=ROOT/'results'/'HDIM-02_shape_metric_clt.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'C':C.tolist(),'G':G.tolist(),'eigC':eC.tolist()},indent=2))
