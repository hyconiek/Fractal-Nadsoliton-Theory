#!/usr/bin/env python3
from pathlib import Path
import json, itertools, numpy as np
ROOT=Path(__file__).resolve().parents[1]

def mode_set(d):
    modes=[]
    # basis, doubles, pair sums: same target-blind primitive grammar used previously
    for i in range(d):
        e=[0]*d;e[i]=1;modes.append(tuple(e))
    for i in range(d):
        e=[0]*d;e[i]=2;modes.append(tuple(e))
    for i in range(d):
        for j in range(i+1,d):
            e=[0]*d;e[i]=1;e[j]=1;modes.append(tuple(e))
    return modes

def relation_matrix(d,modes):
    # constraints phi_k - k dot alpha =0 eliminated using basis phases alpha_i=phi_ei
    # Rows on mode phases: for each non-basis mode, phi_mode - sum k_i phi_basis_i =0.
    m=len(modes); rows=[]
    for idx,k in enumerate(modes[d:],start=d):
        r=np.zeros(m,dtype=int);r[idx]=1
        for i,c in enumerate(k): r[i]-=c
        rows.append(r)
    return np.array(rows,dtype=int)
rows={}
for d in range(1,5):
    modes=mode_set(d);R=relation_matrix(d,modes)
    rank=int(np.linalg.matrix_rank(R.astype(float))) if len(R) else 0
    rows[str(d)]={'mode_count':len(modes),'relation_rank':rank,'nullity':len(modes)-rank,
                  'expected_nullity':d,'modes':[list(x) for x in modes]}
    assert len(modes)-rank==d
