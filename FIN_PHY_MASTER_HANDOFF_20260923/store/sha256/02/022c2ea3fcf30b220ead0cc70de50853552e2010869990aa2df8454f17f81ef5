#!/usr/bin/env python3
from pathlib import Path
import sys,json
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces()
w=np.array([W[0,d] for d in range(1,7)],float)
non_nn={d:float(w[d-1]) for d in range(2,7)}
assert all(v>0 for v in non_nn.values())
# row-sum fraction outside nearest-neighbour shell
row=float(W[0].sum()); nn=float(2*w[0]); residual=row-nn
out={
 'task':'OPERATOR-REFINE-06_exact_local_edge_subdivision_schur_no_go',
 'scientific_state':'PROVED_CLASS_NO_GO',
 'declared_class':'A metric circle obtained only by subdividing each coarse nearest-neighbour edge into a chain of positive local conductances, followed by exact static Kron/Schur elimination of all inserted vertices.',
 'theorem':'Eliminating interior vertices of a chain replaces that chain by one effective conductance between its two endpoints. Since the subdivided circle is a union of edge-disjoint chains between consecutive retained coarse vertices, its Kron reduction has support only on the coarse cycle nearest-neighbour edges. It cannot generate shell d>=2 couplings.',
 'strict_non_nearest_shells':non_nn,
 'strict_total_exit_weight':row,'nearest_neighbor_exit_weight':nn,'non_nearest_fraction_of_exit_weight':residual/row,
 'consequence':'The full dense strict W is not the exact static coarse Schur image of a purely local 1D edge-subdivision Dirichlet graph. The previously derived metric-circle/Dirichlet bridge applies to the extracted nearest-neighbour backbone unless an additional mechanism explains the other five shells.',
 'nonconclusions':['This does not rule out dynamic/resolvent elimination, hidden branches, higher-dimensional hidden graphs, or explicitly nonlocal continuum actions.','It does not challenge the intrinsic carrier theorem.']
}
(ROOT/'results'/'OPERATOR-REFINE-06_local_schur_no_go.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps(out,indent=2))
