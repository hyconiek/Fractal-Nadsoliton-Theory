import json, math
from pathlib import Path
import numpy as np
ROOT=Path(__file__).resolve().parents[1]

def log_no_collision(M,q):
    if M>q:return -math.inf
    return sum(math.log1p(-i/q) for i in range(M))

def p_no_collision(M,q):
    z=log_no_collision(M,q)
    return 0.0 if not math.isfinite(z) else math.exp(z)

def q_for_prob(M,target=.95):
    lo=max(M,1); hi=max(M*M,lo)
    while p_no_collision(M,hi)<target: hi*=2
    while lo<hi:
        mid=(lo+hi)//2
        if p_no_collision(M,mid)>=target:hi=mid
        else:lo=mid+1
    return lo

rows=[]
