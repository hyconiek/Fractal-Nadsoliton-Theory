import json, math, sys
from pathlib import Path
import numpy as np
from scipy.special import softmax
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces()
coex=json.loads((ROOT/'inputs'/'R7P-026_equal_energy_event.json').read_text())
root=np.array([float(x) for x in coex['root_center']])
s=root[:4]; g=float(root[4])
p=softmax(C4@s)
# Trace-normalized active sector weights. Multiplicities 2,2,2,1.
lam=np.array([L[3],L[4],L[5],L[6]],float)
mult=np.array([2,2,2,1],float)
T=float(mult@lam)
w=lam/T
# Exact small symmetry-breaking direction inside col(X7): add eps*x3c*x3c^T.
h=X7[:,0]
vals=[]
for a in range(12):
    P,_=model.d12_actions(X7)[(a,1)]
    pa=P@p
    vals.append(float(h@pa))
sq=np.array(vals)**2
out={
 'task':'PHY-015',
 'scientific_state':'PROVED_STRUCTURAL_NEIGHBORHOOD_AND_EXACT_SYMMETRY_BREAKING_WITNESS',
 'active_lambdas':lam.tolist(),
 'trace_active':T,
 'trace_normalized_weights':w.tolist(),
 'same_support_phase_alignment':'exact for every strictly positive active weight tuple; Bessel/character coefficient signs do not depend on weight magnitudes',
 'coexistence_persistence':'qualitative open-neighborhood theorem by IFT + transverse energy crossing + compact complement gap; crossing gain shifts continuously',
 'symmetry_breaking_perturbation':'A_eps=A7+eps*h*h^T, h=X7[:,0]; centered PSD rank7 for eps>-1 and generic eps!=0 breaks D12',
 'translated_h_means':vals,
 'translated_h_mean_squares':sq.tolist(),
 'square_unique_rounded':sorted(set(round(float(x),12) for x in sq)),
 'first_order_energy_shift_formula':'dV/deps=-(g/2)*(h^T p)^2 at fixed translated coexistence state',
 'first_order_shift_nonzero_class':float(-g/2*sq.max()),
 'first_order_shift_zero_class':0.0,
 'conclusion':[
   'phase alignment is structural across the positive same-support spectral family',
   'the first-order coexistence mechanism persists on some open same-symmetry parameter neighborhood',
   'exact 12-fold equality is symmetry-protected and is split by arbitrarily small noncirculant perturbations',
   'specific ratios and transition gains remain model-specific'
 ]
}
(ROOT/'results'/'PHY-015_universality.json').write_text(json.dumps(out,indent=2))
print(json.dumps(out,indent=2))
