#!/usr/bin/env python3
from pathlib import Path
import json, math, sys
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces();q=12;j=np.arange(q);u=np.ones(q)/q

def ec(k): return np.sqrt(2/q)*np.cos(2*np.pi*k*j/q)
def es(k): return np.sqrt(2/q)*np.sin(2*np.pi*k*j/q)
r=.04
def state(phi): return u+r*ec(1)+r*(math.cos(phi)*ec(2)+math.sin(phi)*es(2))
def ent(p): return float(np.sum(p*np.log(p/u)))
def energy(p):
 f=p-u;return float(.5*f@A@f)
rows=[]
for ph in [0,math.pi/6,math.pi/3,math.pi/2,2*math.pi/3,math.pi]:
 p=state(ph);rows.append({'phi2_relative':ph,'min_p':float(p.min()),'entropy_D':ent(p),'quadratic_E':energy(p)})
Es=[x['quadratic_E'] for x in rows];Ds=[x['entropy_D'] for x in rows]
assert max(Es)-min(Es)<1e-14 and max(Ds)-min(Ds)>1e-3
out={
 'task':'HDIM-11-nonlinear-symmetry-breaking',
 'scientific_state':'EXACT_CONSTRUCTION_SHOWS_T5_NOT_SYMMETRY_OF_ENTROPY_GAIN_MODEL',
 'rows':rows,
 'quadratic_energy_spread':max(Es)-min(Es),
 'entropy_spread':max(Ds)-min(Ds),
 'analytic_mechanism':'The entropy expansion contains resonant monomials coupling modal phases (already 2*1-2=0 for modes 1 and 2). The quadratic circulant form is diagonal by mode and cannot see these relative phases.',
 'conclusion':'Independent doublet rotations are exact symmetries of the strict quadratic operator/action, but not of V_g=D(p||u)-g(p-u)^T A(p-u)/2. The nonlinear equilibrium model breaks the operator T5 down to its finite/locked phase structure.',
 'importance':'HDIM-09 is a real higher-dimensional FIN-internal carrier, but its physical use requires a reason to privilege the quadratic/linear sector or a new law protecting part of the torus against nonlinear locking.',
 'nonconclusions':['The symmetry breaking does not invalidate the strict operator theorem.','It does not prove the spectral phases are gauge variables or spatial coordinates.']
}
p=ROOT/'results'/'HDIM-11_nonlinear_breaking.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'Espread':out['quadratic_energy_spread'],'Dspread':out['entropy_spread']},indent=2))
