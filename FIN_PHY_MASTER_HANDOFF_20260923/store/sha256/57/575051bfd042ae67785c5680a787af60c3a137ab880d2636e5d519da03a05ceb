W,A,L,X,C4,A7=feature_spaces();q=12;kappa=.25
# exact finite max sensitivity geometry for N=1 local acceptance
D=np.maximum(np.sum(X*X,axis=1)[:,None]+np.sum(X*X,axis=1)[None,:]-2*X@X.T,0.0)
R=0.0;arg=None
for k in range(q):
 for c in range(q):
