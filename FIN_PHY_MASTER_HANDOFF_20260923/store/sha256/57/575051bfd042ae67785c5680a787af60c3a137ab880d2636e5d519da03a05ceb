}
# long-range ring row sums for weights r^-alpha, including two directions, finite M approximation
def rowsum(M,alpha):
    half=M//2
    s=0.
    for r in range(1,half+1):
        mult=1 if (M%2==0 and r==half) else 2
        s+=mult*r**(-alpha)
    return s
