# change in local log ratio from changing one neighbor <= kappa/2 * w * R
cM=kappa*R/2 # Metropolis acceptance Lipschitz <=1
cB=cM/4      # Barker logistic derivative <=1/4

def poisson_tail_series(a,d):
    # sum_{n=d} inf a^n/n!, evaluated robustly
    if d<=0:return math.exp(a)
    term=a**d/math.factorial(d)
    s=term;n=d
    while term>1e-16*max(1,s) and n<10000:
        n+=1;term*=a/n;s+=term
    return s

def strict_tail(delta,t,d):
    return min(1.0,poisson_tail_series(delta*t,d))
# generic support-only bound with rate-1 clocks and degree Delta
examples={}
