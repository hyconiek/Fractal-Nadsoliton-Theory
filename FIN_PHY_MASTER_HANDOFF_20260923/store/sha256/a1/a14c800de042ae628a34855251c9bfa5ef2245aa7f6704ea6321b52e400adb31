W,A,L,X7,C4,A7=model.feature_spaces()
LAM=np.array([L[3],L[4],L[5],L[6]],float)


def aligned_design(q:int, parity:bool):
    j=np.arange(q,dtype=float)
    cols=[]
    for idx,k in enumerate((3,4,5)):
        amp=math.sqrt(float(LAM[idx])/6.0)
        cols.append(amp*np.cos(2*np.pi*k*j/q))
    if parity:
        cols.append(math.sqrt(float(LAM[3])/12.0)*((-1.0)**np.arange(q)))
    return np.column_stack(cols)


def full_design(q:int, parity:bool):
    j=np.arange(q,dtype=float); cols=[]
    for idx,k in enumerate((3,4,5)):
        amp=math.sqrt(float(LAM[idx])/6.0)
        cols += [amp*np.cos(2*np.pi*k*j/q),amp*np.sin(2*np.pi*k*j/q)]
    if parity:
        cols.append(math.sqrt(float(LAM[3])/12.0)*((-1.0)**np.arange(q)))
    return np.column_stack(cols)


def dual(s,g,Xa):
    h=Xa@s
    m=float(np.max(h))
    return float(s@s/(2*g) - (m+math.log(float(np.mean(np.exp(h-m))))))


def optimize_branch(q:int,g:float,parity:bool,warm=None):
    X=aligned_design(q,parity)
    d=X.shape[1]
    starts=[]
    if warm is not None:
        w=np.asarray(warm,float)
        if len(w)==d: starts.append(w)
    for a in (0.5,1,2,3,4,5): starts.append(np.ones(d)*a)
    best=None
    for x0 in starts:
        r=minimize(lambda x:dual(x,g,X),x0,method='BFGS',options={'gtol':1e-11,'maxiter':1800})
        cand=(float(r.fun),np.asarray(r.x,float),bool(r.success),float(np.linalg.norm(r.jac)) if getattr(r,'jac',None) is not None else None)
        if best is None or cand[0]<best[0]: best=cand
    phi,s,success,grad=best
    h=X@s; hmax=float(h.max()); p=np.exp(h-hmax); p=p/p.sum()
    Xf=full_design(q,parity)
    mu=Xf.T@p
    # modal radii; aligned root should have sine means approx zero
    radii=[float(math.hypot(mu[2*i],mu[2*i+1])) for i in range(3)]
    z=float(mu[-1]) if parity else 0.0
    return {'q':q,'g':g,'parity':parity,'phi':phi,'s':s.tolist(),'success':success,'grad_norm':grad,
            'pmax':float(p.max()),'radii':radii,'z':z,'mu':mu.tolist()}


def d2_offsets(q:int,radii,z=0.0,parity=False):
    out=[]
    for r in range(1,q//2+1):
        d2=0.0
        for rho,k in zip(radii,(3,4,5)):
            d2 += 2*rho*rho*(1-math.cos(2*math.pi*k*r/q))
        if parity and (r%2): d2 += 4*z*z
        out.append((r,max(d2,0.0)))
    return out


def degree_for_offsets(q,offs):
    return sum(1 if (q%2==0 and r==q//2) else 2 for r in offs)


def connectivity_offsets(q, dist_rows, allowed=None, divisor=1):
    # For a circulant on Z_{q/divisor} represented by original offsets r divisible by divisor.
    # Include complete equal-distance shells in ascending order until gcd condition gives connectivity.
    n=q//divisor
    rows=[(r,d2) for r,d2 in dist_rows if (allowed is None or allowed(r))]
    rows.sort(key=lambda x:(x[1],x[0]))
    selected=[]; threshold=None
    i=0
    while i<len(rows):
        val=rows[i][1]
        tol=max(1e-13,1e-11*max(1.0,abs(val)))
        shell=[]
        while i<len(rows) and abs(rows[i][1]-val)<=tol:
            shell.append(rows[i][0]); i+=1
        selected.extend(shell); threshold=val
        g=n
        for r in selected: g=math.gcd(g,r//divisor)
        if g==1:
            return {'offsets':sorted(set(selected)),'threshold_d2':float(threshold),'threshold':float(math.sqrt(max(threshold,0))),
                    'degree':degree_for_offsets(q,selected),'connected_gcd':1}
    return {'offsets':sorted(set(selected)),'threshold_d2':float(threshold) if threshold is not None else None,
            'threshold':float(math.sqrt(max(threshold,0))) if threshold is not None else None,
            'degree':degree_for_offsets(q,selected),'connected_gcd':None}


def rg1(rec):
    rows=d2_offsets(rec['q'],rec['radii'],rec['z'],rec['parity'])
    out=connectivity_offsets(rec['q'],rows)
    out['rule']='minimal all-pairs distance threshold making the translation-orbit graph connected'
    return out


def rg2(rec):
    assert rec['parity'] and rec['q']%2==0
    q=rec['q']; rows=d2_offsets(q,rec['radii'],rec['z'],True)
    within=connectivity_offsets(q,rows,allowed=lambda r:r%2==0,divisor=2)
    odds=[(r,d2) for r,d2 in rows if r%2==1]
    m=min(d2 for _,d2 in odds); tol=max(1e-13,1e-11*max(1.0,abs(m)))
    cross=sorted(r for r,d2 in odds if abs(d2-m)<=tol)
    offs=sorted(set(within['offsets']+cross))
    return {'rule':'parity-fiber-aware: connect each Z2 sheet at its minimal intrinsic threshold, then add the nearest cross-sheet shell',
            'within_offsets':within['offsets'],'within_threshold':within['threshold'],'cross_offsets':cross,
            'cross_threshold':math.sqrt(max(m,0.0)),'offsets':offs,'degree':degree_for_offsets(q,offs)}


def lap_eig_jump12(q,k):
    th=2*math.pi*k/q
    return 2*(1-math.cos(th))+2*(1-math.cos(2*th))


def q12_event():
    certp=ROOT/'inputs'/'R7P-026_equal_energy_event.json'
    cert=json.loads(certp.read_text())
    # certificate center coordinates s3,s4,s5,s6 in aligned C4 chart
    if 'root_center' in cert: s=cert['root_center'][:4]
    elif 's_center' in cert: s=cert['s_center']
    else:
        # common producer structure: center of root_box coordinates first 4 amplitudes
        rb=cert.get('root_box') or cert.get('box')
        if rb:
            s=[(float(a)+float(b))/2 for a,b in rb[:4]]
        else:
            # stable known center from accepted R7P-026, only fallback if schema changed
            s=[1.81990358,1.91398955,1.91456913,1.36720328]
    s=np.asarray(s,float)
    X=aligned_design(12,True); h=X@s; p=np.exp(h-h.max()); p/=p.sum(); Xf=full_design(12,True); mu=Xf.T@p
    rec={'q':12,'g':float(cert.get('g_root_center',cert.get('g_center',3.7183448981203875))), 'parity':True,
         's':s.tolist(),'pmax':float(p.max()),'radii':[float(math.hypot(mu[2*i],mu[2*i+1])) for i in range(3)],'z':float(mu[-1]),'mu':mu.tolist()}
    rec['RG1']=rg1(rec); rec['RG2']=rg2(rec)
    rec['offset_distances']=[{'r':r,'distance':math.sqrt(d2)} for r,d2 in d2_offsets(12,rec['radii'],rec['z'],True)]
    return rec


