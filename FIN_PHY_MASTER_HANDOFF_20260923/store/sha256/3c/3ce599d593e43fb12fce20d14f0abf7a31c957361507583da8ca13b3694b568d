  'pair_expected_feature_distance2':{'PM001':basej['mean_difference_PM']['expected_feature_distance2'],'PM002':basej['full_p_difference_control_PM']['expected_feature_distance2']},
  'path3_endpoint_mutual_information_nats':{'PM001':basej['mean_difference_PM']['endpoint_mutual_information_nats'],'PM002':basej['full_p_difference_control_PM']['endpoint_mutual_information_nats']}
 },
 'pair_full_distribution':{'TV':TV,'KL_P_to_Q_nats':KL,'Chernoff_information':chern,'Chernoff_s':sopt,'iid_samples_upper_bound_bayes_error':nsamp},
 'feature_distance_scalar_power':{'difference':delta,'variance_under_PM001':varP,'n_for_5sigma_mean_separation_idealized':z5},
 'nuisances':['state misclassification','correlated samples/effective sample size','control drift','unknown edge heterogeneity','finite-N mismatch','non-equilibrium preparation'],
