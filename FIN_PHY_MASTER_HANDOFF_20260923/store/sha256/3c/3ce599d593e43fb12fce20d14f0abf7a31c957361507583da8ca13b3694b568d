import json, math, sys
from pathlib import Path
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
from R7P_model import feature_spaces
W,A,L,X,C4,A7=feature_spaces()
N=2;g=3.7;kappa=.25;q=12
states=[]
def rec(rem,i,cur):
    if i==q-1: states.append(tuple(cur+[rem]));return
    for v in range(rem+1):rec(rem-v,i+1,cur+[v])
rec(N,0,[])
ns=np.array(states);ps=ns/N;ms=ps@X
from math import factorial
mult=np.array([factorial(N)/math.prod(factorial(int(v)) for v in n) for n in ns],float)
base=mult/q**N;lw=base*np.exp(N*g/2*np.sum(ms*ms,axis=1))
def d2(V):
    s=np.sum(V*V,axis=1);return np.maximum(s[:,None]+s[None,:]-2*V@V.T,0)
Dm=d2(ms);Dp=d2(ps)
def pair(D):
    C=np.exp(-N*kappa/2*D);raw=lw[:,None]*lw[None,:]*C;return raw/raw.sum()
P=pair(Dm).ravel();Q=pair(Dp).ravel()
TV=.5*np.abs(P-Q).sum();KL=float(np.sum(P*np.log(P/Q)))
ss=np.linspace(0,1,20001);vals=np.array([np.sum(P**s*Q**(1-s)) for s in ss]);i=int(np.argmin(vals));chern=float(-np.log(vals[i]));sopt=float(ss[i])
nsamp={str(err):math.ceil(math.log(0.5/err)/chern) for err in (0.1,0.05,0.01)}
dmf=Dm.ravel();mP=float(np.sum(P*dmf));mQ=float(np.sum(Q*dmf));varP=float(np.sum(P*(dmf-mP)**2));delta=abs(mP-mQ)
z5=math.ceil((5*math.sqrt(varP)/delta)**2)
basej=json.loads((ROOT/'results'/'PHY-003_composition.json').read_text())
