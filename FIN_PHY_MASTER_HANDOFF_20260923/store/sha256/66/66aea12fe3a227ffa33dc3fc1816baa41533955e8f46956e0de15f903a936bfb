#!/usr/bin/env python3
from pathlib import Path
import subprocess,sys,hashlib
root=Path(__file__).resolve().parent
scripts=sorted((root/'scripts').glob('*.py'))
for p in scripts:
    subprocess.run([sys.executable,str(p)],check=True,cwd=root)
if '--check' in sys.argv:
    expected={}
    for line in (root/'EXPECTED_RESULTS.sha256').read_text().splitlines():
        if not line.strip(): continue
        h,name=line.split('  ',1); expected[name]=h
    bad=[]
    for name,h0 in expected.items():
        p=root/name; h=hashlib.sha256(p.read_bytes()).hexdigest()
        if h!=h0: bad.append((name,h0,h))
    if bad:
        for x in bad: print('MISMATCH',x)
        raise SystemExit(1)
    print(f'REPLAY CHECK PASS: {len(expected)}/{len(expected)} result files identical')
