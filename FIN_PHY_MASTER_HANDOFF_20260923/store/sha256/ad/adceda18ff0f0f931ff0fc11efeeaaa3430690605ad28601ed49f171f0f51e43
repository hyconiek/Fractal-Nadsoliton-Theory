#!/usr/bin/env python3
from pathlib import Path
import sys,json
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'inputs'))
import R7P_model as model
W,A,L,X7,C4,A7=model.feature_spaces(); M=A.shape[0]
I2=np.eye(2); L2=np.array([[1.,-1.],[-1.,1.]])
u=np.ones(2)/np.sqrt(2)
R=np.kron(np.eye(M),u[:,None]) # 24x12
mus=[0.0,0.1,1.0,10.0]
rows=[]
for mu in mus:
    Af=np.kron(A,I2)+mu*np.kron(np.eye(M),L2)
    resid=float(np.linalg.norm(Af@R-R@A,ord=2))
    evals=np.linalg.eigvalsh(Af)
    rows.append({'mu':mu,'intertwining_residual_opnorm':resid,'smallest_eigs':evals[:6].tolist(),'largest_eig':float(evals[-1])})
# two-level arbitrary sequence example; property follows inductively
seqs=[[0.1,0.1],[0.1,10.0],[10.0,0.1],[10.0,10.0]]
seqrows=[]
for seq in seqs:
    An=A.copy(); Rtot=np.eye(M)
    cur=M
    for mu in seq:
        uu=np.ones(2)/np.sqrt(2)
        Rstep=np.kron(np.eye(cur),uu[:,None])
        Anext=np.kron(An,I2)+mu*np.kron(np.eye(cur),L2)
        Rtot=Rstep@Rtot
        An=Anext; cur*=2
    resid=float(np.linalg.norm(An@Rtot-Rtot@A,ord=2))
    seqrows.append({'mu_sequence':seq,'dimension':cur,'coarse_intertwining_residual_opnorm':resid,'spectral_max':float(np.linalg.eigvalsh(An)[-1])})
out={
 'task':'OPERATOR-REFINE-07_exact_intertwining_fiber_moduli',
 'scientific_state':'PROVED_EXACT_REFINEMENT_NONUNIQUENESS',
 'one_step_family':'A_2M=A_M tensor I2 + mu I_M tensor L2; R e_i=e_i tensor (1,1)/sqrt(2).',
 'theorem':'For every mu>=0, L2 u=0 implies A_2M R=R A_M exactly. Repeating the construction permits an arbitrary nonnegative sequence mu_n while preserving the entire nested coarse sector.',
 'one_step_checks':rows,'two_step_checks':seqrows,
 'consequence':'Exact generator/semigroup intertwining across refinements does not source fine dynamics, fiber gaps, or a continuum scaling law. A separate fiber/refinement-scale principle is required.',
 'nonconclusions':['The family is a conditional refinement architecture, not a claim that it is the physical strict refinement.','Coarse operational equivalence does not identify hidden fine modes.']
}
(ROOT/'results'/'OPERATOR-REFINE-07_intertwining_moduli.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps(out,indent=2))
