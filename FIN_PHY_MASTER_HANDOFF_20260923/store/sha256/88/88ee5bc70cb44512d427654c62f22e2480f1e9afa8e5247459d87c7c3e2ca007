def partition(moduli,modes,b,phi):
    pts=list(itertools.product(*[range(n) for n in moduli]))
    vals=[]
    for x in pts:
        h=0.0
        for kk,bb,pp in zip(modes,b,phi):
            ang=2*np.pi*sum(kk[i]*x[i]/moduli[i] for i in range(len(moduli)))+pp
            h+=bb*math.cos(ang)
        vals.append(math.exp(h))
    return sum(vals)/len(vals)

def translated_phase(moduli,modes,x0):
    return np.array([2*np.pi*sum(k[i]*x0[i]/moduli[i] for i in range(len(moduli))) for k in modes])

def case(moduli,modes,seed):
    rng=np.random.default_rng(seed);b=rng.uniform(.2,.7,size=len(modes))
    pts=list(itertools.product(*[range(n) for n in moduli]))
    trans=[partition(moduli,modes,b,translated_phase(moduli,modes,x),np.zeros(0)) if False else None for x in []]
    vals=[]
    for x in pts:
        # Sign convention irrelevant: +/- translation both run over whole group.
        ph=translated_phase(moduli,modes,x)
        vals.append(partition(moduli,modes,b,ph))
    controls=[]
    for _ in range(2000):
        ph=rng.uniform(-np.pi,np.pi,size=len(modes));controls.append(partition(moduli,modes,b,ph))
    return {'moduli':moduli,'group_order':int(np.prod(moduli)),'mode_count':len(modes),'translation_max_spread':max(vals)-min(vals),
            'translation_max':max(vals),'random_control_max':max(controls),'random_gap':max(vals)-max(controls)}
