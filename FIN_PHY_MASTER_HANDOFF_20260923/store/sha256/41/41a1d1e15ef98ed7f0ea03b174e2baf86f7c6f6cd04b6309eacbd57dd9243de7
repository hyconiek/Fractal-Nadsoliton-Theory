#!/usr/bin/env python3
from pathlib import Path
import json, numpy as np
ROOT=Path(__file__).resolve().parents[1]
rng=np.random.default_rng(20260923)
# Numerical illustration: random planar points have strict triangle inequalities for all distinct triples almost surely.
pts=rng.normal(size=(20,2))
D=np.linalg.norm(pts[:,None,:]-pts[None,:,:],axis=2)
min_slack=float('inf'); arg=None
for i in range(len(pts)):
  for j in range(len(pts)):
    if j==i: continue
    for k in range(len(pts)):
      if k in (i,j): continue
      slack=D[i,k]+D[k,j]-D[i,j]
      if slack<min_slack: min_slack=float(slack);arg=(i,k,j)
out={
 'task':'PRIN-04-exact-backbone-higher-dimensional-no-go',
 'scientific_state':'PROVED_ANALYTIC_GENERIC_EXACT_METRIC_REALIZATION_IS_COMPLETE',
 'theorem':'Let a finite metric sample satisfy strict triangle inequality d(x,y)<d(x,z)+d(z,y) for every distinct triple. Give graph edges their inherited metric lengths. If the graph shortest-path metric must equal d for every pair, then every pair must be an edge; the graph is complete.',
 'proof':'If x-y were missing, any graph path x=v0,...,vn=y has n>=2. Repeated triangle inequality, with at least one strict step under the hypothesis, gives sum d(v_i,v_{i+1})>d(x,y), contradicting exact shortest-path preservation.',
 'generic_manifold_implication':'For continuously sampled generic points in Euclidean dimension >=2 (and locally on generic smooth Riemannian manifolds away from cut-locus/collinearity degeneracies), exact third-point geodesic alignment has probability zero. Thus the exact all-pairs metric-backbone rule generically produces K_M, not bounded-degree locality.',
 'why_S1_is_special':'On a one-dimensional circle, intermediate sample points lie on minimizing arcs and geodesic distances add exactly, allowing a sparse cycle to preserve the sampled metric.',
 'numeric_planar_control':{'n':20,'minimum_triangle_slack':min_slack,'triple':arg},
 'consequence':'The zero-distortion all-pairs backbone principle cannot be the universal higher-dimensional locality source. A future DIM-SOURCE success needs a different local/approximate metric principle or additional incidence/cell structure.',
 'nonconclusions':['This does not refute the 1D cycle theorem.','It does not choose among Delaunay, relative-neighborhood, Gabriel, spanner or other higher-dimensional proximity rules.']
}
assert min_slack>0
p=ROOT/'results'/'PRIN-04_exact_backbone_dimension_no_go.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'min_slack':min_slack},indent=2))
