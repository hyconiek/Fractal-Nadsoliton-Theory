#!/usr/bin/env python3
from pathlib import Path
import sys,json,math
import numpy as np
from scipy.optimize import brentq
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'inputs'))
import R7P_model as model
N=12
W=np.asarray(model.strict_kernel(),float); A=np.asarray(model.laplacian(W),float); s=float(A[0,0])
P=W/s; np.fill_diagonal(P,0.0)
eta0=np.linspace(0.80,0.98,N)

def C_of(eps):
    C=np.zeros((N,N),float)
    for j in range(N):
        C[j,j]=1-2*eps
        C[j,(j-1)%N]=eps
        C[j,(j+1)%N]=eps
    return C

eps0=.05; C0=C_of(eps0)
Q=[]
for i in range(N):
    p=P[i]; Q.append(C0.T@(eta0*p)/float(eta0@p))
Q=np.array(Q)

def self_score(eps,i=0):
    y=np.linalg.inv(C_of(eps).T)@Q[i]
    return float(y[i]/eta0[i])
# root in external calibration interval; dense derivative sign check supports uniqueness in this declared 1d family.
eps_lo,eps_hi=.04,.06
root=brentq(lambda x:self_score(x,0),eps_lo,eps_hi,xtol=1e-15)
grid=np.linspace(eps_lo,eps_hi,10001)
vals=np.array([self_score(x,0) for x in grid])
diffs=np.diff(vals)
monotone_decreasing=bool(np.all(diffs<0))
# all 12 source self scores at root
self_res=[self_score(root,i) for i in range(N)]

# Once confusion is fixed by structural zero, independent multiplicative eta intervals have exact top-two threshold.
p1=float(P[0,1]); p2=float(P[0,2])
r_star=(p1-p2)/(p1+p2)
r_safe=.95*r_star; r_fail=1.05*r_star
near_safe=p1/(1+r_safe); comp_safe=p2/(1-r_safe)
near_fail=p1/(1+r_fail); comp_fail=p2/(1-r_fail)
# General all-source/all-competitor check at safe radius.
min_margin=float('inf'); wit=None
for i in range(N):
    near={(i-1)%N,(i+1)%N}
    for a in near:
      for b in range(N):
        if b in near or b==i: continue
        margin=float(P[i,a]/(1+r_safe)-P[i,b]/(1-r_safe))
        if margin<min_margin:
            min_margin=margin; wit={'source':i,'near':a,'competitor':b,'margin':margin,'p_near':float(P[i,a]),'p_competitor':float(P[i,b])}

result={
 'task':'OCB-CAL-02',
 'status':'STRUCTURAL_ZERO_COLLAPSES_CONFUSION_INTERVAL__EFFICIENCY_BOX_HAS_EXACT_THRESHOLD',
 'declared_calibration_family':{
   'confusion':'C(eps): correct 1-2 eps, adjacent reported labels eps each',
   'external_eps_interval':[eps_lo,eps_hi],
   'efficiency_box':'eta_j in eta0_j[1-r,1+r] independently',
   'nominal_eta_minmax':[float(eta0.min()),float(eta0.max())]
 },
 'structural_zero_result':{
   'principle':'In an embedded jump chain the true destination cannot equal the source, so every deconfused candidate must satisfy p_i[i]=0.',
   'source0_self_score_root':root,
   'nominal_eps':eps0,
   'root_error':abs(root-eps0),
   'source0_self_score_at_eps_lo':float(vals[0]),
   'source0_self_score_at_eps_hi':float(vals[-1]),
   'dense_monotone_decreasing_check_10001_points':monotone_decreasing,
   'max_abs_self_score_all_sources_at_root':float(max(abs(x) for x in self_res)),
   'interpretation':'Within this one-parameter confusion family and noiseless full preparation record, the structural zero collapses the external eps interval to the nominal value. This is model-family-specific and not a general calibration theorem.'
 },
 'efficiency_interval_theorem':{
   'shell1_probability':p1,'shell2_probability':p2,
   'exact_halfwidth_threshold_r':r_star,
   'formula':'r*=(p1-p2)/(p1+p2). For every independent multiplicative eta interval eta0_j[1-r,1+r], shell1 outranks shell2 for all calibrations iff r<r*.',
   'safe_fixture_r':r_safe,
   'safe_near_score':near_safe,'safe_competitor_score':comp_safe,
   'minimum_all_source_safe_margin':min_margin,
   'minimum_margin_witness':wit
 },
 'removal_witness':{
   'fail_fixture_r':r_fail,
   'near_score_with_eta_high':near_fail,
   'shell2_score_with_eta_low':comp_fail,
   'ranking_reversed':bool(near_fail<comp_fail),
   'meaning':'Above r*, destination-dependent censoring alone can make a shell-2 destination look more likely than shell-1 while producing an admissible calibration in the declared box.'
 },
 'scope':'The confusion result is exact only inside the declared scalar adjacent-confusion family. General 12x12 interval calibration still requires a separate robust feasibility calculation; do not silently transfer this collapse theorem.',
 'nonconclusion':'No real detector calibration or physical data are supplied.'
}
(Path(__file__).resolve().parents[1]/'results'/'OCB-CAL-02_interval_uncertainty.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
print(json.dumps({'status':result['status'],'eps_root':root,'monotone':monotone_decreasing,'r_star':r_star,'r_safe':r_safe,'min_margin':min_margin,'fail_reversed':near_fail<comp_fail},indent=2))
