#!/usr/bin/env python3
from pathlib import Path
import json, math
import mpmath as mp
import numpy as np
ROOT=Path(__file__).resolve().parents[1]
mp.mp.dps=80
# Inherited strict spectrum declarations.
lam=[mp.mpf('1.9614068619764455'),mp.mpf('2.19956884933321'),mp.mpf('2.298606272079097'),mp.mpf('2.3421820411463004')]
c=[mp.sqrt(lam[i]/(6 if i<3 else 12)) for i in range(4)]
k=[3,4,5]
g=mp.mpf(7)
s0=[mp.mpf('3.547595277395986'),mp.mpf('3.783140506071965'),mp.mpf('3.677956492814370')]
# exact parity root in b=c6*s6
alpha=g*c[3]**2
b0=mp.findroot(lambda b:b/alpha-mp.tanh(b), mp.mpf('1.08'))
s60=b0/c[3]
center=s0+[s60]
r=mp.mpf('0.001')
# Smooth continuum certificate produced earlier.
base=json.loads((ROOT/'results'/'PHY-013_smooth_continuum_certificate.json').read_text())
Jlo=np.zeros((4,4),float); Jhi=np.zeros((4,4),float)
Jlo[:3,:3]=np.array(base['J_box_lower'],float); Jhi[:3,:3]=np.array(base['J_box_upper'],float)
# parity block over s6 box. b=c6*s6, J44=1/g-c6^2 sech^2(b)
blo=c[3]*(s60-r); bhi=c[3]*(s60+r)
# positive b and sech2 decreases with b, so J increases with b
j44lo=1/g-c[3]**2/(mp.cosh(blo)**2)
j44hi=1/g-c[3]**2/(mp.cosh(bhi)**2)
Jlo[3,3]=float(j44lo); Jhi[3,3]=float(j44hi)
# Continuum center F bounds: smooth inherited; parity evaluated high precision.
Flo=np.array([float(x[0]) for x in base['F_interval']]+[float(s60/g-c[3]*mp.tanh(b0))])
Fhi=np.array([float(x[1]) for x in base['F_interval']]+[float(s60/g-c[3]*mp.tanh(b0))])
# Uniform smooth exponent bounds over full box.
sm=[abs(s0[i])+r for i in range(3)]
H0=sum(sm[i]*c[i] for i in range(3)); bmax=c[3]*(abs(s60)+r)
H=[mp.mpf(0)]+[sum(sm[i]*c[i]*(k[i]**n) for i in range(3)) for n in range(1,5)]
B=[mp.mpf(1),None,None,None,None]
B[1]=H[1]; B[2]=H[2]+H[1]**2; B[3]=H[3]+3*H[1]*H[2]+H[1]**3
B[4]=H[4]+4*H[1]*H[3]+3*H[2]**2+6*H[1]**2*H[2]+H[1]**4
zeta4=mp.zeta(4); expH=mp.e**H0

def pderiv_bound(kind,i=None,j=None,n=0):
    if kind=='Z': return mp.mpf(1) if n==0 else mp.mpf(0)
    if kind=='M': return c[i]*(k[i]**n)
    if kind=='Q': return c[i]*c[j]*((k[i]+k[j])**n)

def fourth_bound(kind,i=None,j=None):
    return expH*sum(mp.binomial(4,a)*pderiv_bound(kind,i,j,a)*B[4-a] for a in range(5))

def trap_err(kind,n,i=None,j=None):
    # valid for any shifted n-point trapezoid rule on 2pi-periodic C4 function
    return 2*zeta4*fourth_bound(kind,i,j)/(mp.mpf(n)**4)

def finite_perturb(q):
    assert q%2==0
    n=q//2
    eZ=trap_err('Z',n)
    eM=[trap_err('M',n,i=i) for i in range(3)]
    eQ=[[trap_err('Q',n,i=i,j=j) for j in range(3)] for i in range(3)]
    # finite-vs-continuum raw weighted sums acquire at most exp(|b|) times shifted trap errors.
    eb=mp.e**bmax
    # Zq lower directly from pointwise exponent bound.
    Zqlower=mp.e**(-H0-bmax)
    # ratio error for E[p]: (err_N+pmax err_Z)/Zq.
    dmu=[eb*(eM[i]+c[i]*eZ)/Zqlower for i in range(3)]
    dmu6=eb*(c[3]*eZ+c[3]*eZ)/Zqlower
    dmu.append(dmu6)
    # second moment finite-vs-continuum ratio bounds
    dsec=np.zeros((4,4),float)
    for i in range(3):
        for j in range(3):
            x=eb*(eQ[i][j]+c[i]*c[j]*eZ)/Zqlower
            dsec[i,j]=float(x)
    # smooth-parity raw numerator uses c6*x_i with alternating sign
    for i in range(3):
        x=eb*(c[3]*eM[i]+c[i]*c[3]*eZ)/Zqlower
        dsec[i,3]=dsec[3,i]=float(x)
    dsec[3,3]=0.0 # x6^2=c6^2 exactly under both laws
    # covariance differences
    dcov=np.zeros((4,4),float)
    cf=np.array([float(x) for x in c])
    dm=np.array([float(x) for x in dmu])
    for i in range(4):
        for j in range(4):
            dcov[i,j]=dsec[i,j]+dm[i]*cf[j]+dm[j]*cf[i]
    return {'n':n,'eZ':float(eZ),'dmu':dm,'dcov':dcov}

# continuum preconditioner at box midpoint
Jmid0=(Jlo+Jhi)/2
Ainv=np.linalg.inv(Jmid0)

def certify(q):
    per=finite_perturb(q)
    dcov=per['dcov']
    # J=I/g-Cov, so enlarge every entry by covariance perturbation.
    lo=Jlo-dcov; hi=Jhi+dcov
    Jmid=(lo+hi)/2; Jrad=(hi-lo)/2
    # finite F(center)=continuum F(center)-delta mean; enlarge F interval by dmu.
    fl=Flo-per['dmu']; fh=Fhi+per['dmu']
    fmid=(fl+fh)/2; frad=(fh-fl)/2
    center_shift=np.abs(-Ainv@fmid)+np.abs(Ainv)@frad
    Cmat=np.eye(4)-Ainv@Jmid
    Crad=np.abs(Ainv)@Jrad
    rowsum=np.sum(np.abs(Cmat)+Crad,axis=1)
    kb=center_shift+rowsum*float(r)
    # positive Hessian via midpoint min eig - Frobenius radius
    mineig=float(np.linalg.eigvalsh((Jmid+Jmid.T)/2).min()-np.linalg.norm(Jrad,'fro'))
    return {'q':q,'n':per['n'],'eZ':per['eZ'],'dmu':per['dmu'].tolist(),'max_dcov':float(dcov.max()),
            'krawczyk_bounds':kb.tolist(),'contraction_rows':rowsum.tolist(),'strict':bool(np.all(kb<float(r))),
            'hessian_min_lower':mineig,'pd':mineig>0}

# Scan even q for first point after which monotone n^-4 bounds guarantee all larger even q.
records=[]; first=None
for q in range(16,2002,2):
    z=certify(q)
    if q in [16,24,32,48,64,96,128,192,256,384,512,768,1024,1536,2000]: records.append(z)
    if first is None and z['strict'] and z['pd']:
        first=z
        break
# Include diagnostics around threshold
q0=first['q']
near=[certify(q) for q in range(max(16,q0-10),q0+12,2)]
out={
 'task':'PHY-013-finite-q-branch-certification',
 'scientific_state':'INTERVAL_ASSISTED_UNIFORM_EVEN_Q_BRANCH_CERTIFICATE',
 'g':7.0,'center':[str(x) for x in center],'box_radius_inf':str(r),
 'method':'Continuum interval/Krawczyk box plus uniform shifted-trapezoid C4 error bound on the even/odd q/2 sublattices. Error bounds decrease as (q/2)^-4, so certification at q0 implies all larger even q.',
 'q0_even':q0,'q0_certificate':first,'near_threshold':near,'selected_diagnostics':records,
 'continuum_hessian_parity_interval':[str(j44lo),str(j44hi)],
 'conclusion':f'For every even q >= {q0}, the full smooth-plus-parity finite-q stationarity map at g=7 has a unique stationary point in the declared 4D box, and its Hessian is positive there. The point continues the certified continuum localized branch.',
 'scope':'This is a local branch theorem. It does not prove global minimality, select g=7 physically, or source the q-extension itself.'
}
p=ROOT/'results'/'PHY-013_finite_q_branch_certificate.json'; p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'q0':q0,'cert':first,'near':near},indent=2))
