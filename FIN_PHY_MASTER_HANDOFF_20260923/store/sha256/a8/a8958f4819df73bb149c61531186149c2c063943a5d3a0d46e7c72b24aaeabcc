# Two target-blind multiplicative refinement laws beginning at q0=12.
def factors(q):
 out=[];x=q;p=2
 while p*p<=x:
  if x%p==0:
   a=0
   while x%p==0:a+=1;x//=p
   out.append((p,a,p**a))
  p+=1
 if x>1:out.append((x,1,x))
 return out
rows=[]
for n in range(0,9):
 qa=12*2**n
 qb=12*6**n
 rows.append({'n':n,'q_A':qa,'primary_A':factors(qa),'q_B':qb,'primary_B':factors(qb)})
