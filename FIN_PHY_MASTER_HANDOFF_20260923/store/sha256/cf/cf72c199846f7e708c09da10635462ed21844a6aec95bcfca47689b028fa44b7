#!/usr/bin/env python3
from pathlib import Path
import json, math
import numpy as np
from scipy.spatial.distance import cdist
from scipy.sparse.csgraph import connected_components
ROOT=Path(__file__).resolve().parents[1]
rng=np.random.default_rng(20260923)

def rng_graph(P):
 n=len(P);D=cdist(P,P);A=np.zeros((n,n),bool)
 for i in range(n):
  for j in range(i+1,n):
   dij=D[i,j]
   if not np.any((D[i,:]<dij-1e-14)&(D[j,:]<dij-1e-14)): A[i,j]=A[j,i]=True
 return D,A
rows=[]
for n in [80,160,320,640]:
 # local standardized chart of the flat T4; small-box topology is Euclidean R4.
 P=rng.uniform(-.5,.5,size=(n,4));D,A=rng_graph(P);deg=A.sum(1);edge=D[A]
 rows.append({'n':n,'components':int(connected_components(A.astype(int),directed=False,return_labels=False)),'mean_degree':float(deg.mean()),'max_degree':int(deg.max()),'median_edge_length':float(np.median(edge))})
coef=np.polyfit(np.log([x['n'] for x in rows]),np.log([x['median_edge_length'] for x in rows]),1);slope=float(coef[0])
assert all(x['components']==1 for x in rows)
out={
 'task':'PROX-03-local-T4-RNG-scout',
 'scientific_state':'NUMERICAL_PARAMETER_FREE_LOCALITY_SCOUT_ON_4D_INTERNAL_METRIC__CONTINUUM_OPEN',
 'seed':20260923,'rows':rows,'loglog_median_edge_slope':slope,'four_dimensional_spacing_benchmark':-0.25,
 'analytic_controls':['RNG is metric-only and has no radius or k parameter.','RNG contains the Euclidean MST and is connected.','Incident RNG edges obey an angular packing constraint, so fixed ambient dimension gives a finite degree bound independent of n.'],
 'interpretation':'The origin-free strict T4 has at least a plausible parameter-free sparse proximity construction in a local chart; median edge spacing is numerically close to n^{-1/4}.',
 'open_problem':'No theorem here proves graph-Laplacian convergence, global torus consistency, bounded stretch or a physical locality bridge.',
 'nonconclusions':['The scout does not establish four-dimensional physical space.','The sampled points are synthetic Haar/local-chart points, not sourced FIN preparations.']
}
p=ROOT/'results'/'PROX-03_local_T4_rng.json';p.write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
print(json.dumps({'output':str(p),'slope':slope,'rows':rows},indent=2))
