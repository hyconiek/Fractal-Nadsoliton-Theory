#!/usr/bin/env python3
from pathlib import Path
import subprocess,sys,hashlib
root=Path(__file__).resolve().parent
scripts=[
 'hankel_memory_rank.py',
 'calibration_interval_uncertainty.py',
 'adaptive_hankel_basis.py',
 'channel_jet_estimation.py'
]
env=dict(**__import__('os').environ); env['PYTHONDONTWRITEBYTECODE']='1'
for s in scripts:
    print('RUN',s)
    subprocess.run([sys.executable,str(root/'scripts'/s)],check=True,env=env)
if '--check' in sys.argv:
    expected={}
    for line in (root/'EXPECTED_RESULTS.sha256').read_text().splitlines():
        h,p=line.split(None,1); expected[p.strip()]=h
    bad=[]
    for rel,h0 in expected.items():
        p=root/rel
        h=hashlib.sha256(p.read_bytes()).hexdigest()
        if h!=h0: bad.append((rel,h0,h))
    if bad:
        for x in bad: print('MISMATCH',x)
        raise SystemExit(1)
    print(f'REPLAY CHECK PASS {len(expected)}/{len(expected)} results')
