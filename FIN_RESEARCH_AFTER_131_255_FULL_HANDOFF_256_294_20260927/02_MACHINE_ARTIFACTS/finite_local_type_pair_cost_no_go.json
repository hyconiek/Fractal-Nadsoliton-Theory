  "theorem": {
    "statement": "For finite type set S and pair score C_ij=c(s_i,s_j), all partners of the same endpoint type b are exactly tied. If type b has count n_b, then a source unit sees n_b (or n_b-1 when a=b) equal-score partners. If n_b/n -> f_b>0, tie multiplicity is Theta(n).",
    "consequence": "Fixed finite endpoint types cannot by themselves produce unique bounded-degree incidence at nonvanishing type fractions.",
    "applies_to": [
      "Z3 coarse state (q=3)",
      "Z4 fiber label (q=4)",
      "combined Z3xZ4 localized label (q=12)",
      "any fixed finite collection of local hidden labels"
    ],
    "escape_conditions": [
      "pair-specific state R_ij",
      "number of local types grows with n",
      "accepted type fractions vanish as O(1/n)",
      "extra nonlocal matching/constraint law"
    ]
  }
